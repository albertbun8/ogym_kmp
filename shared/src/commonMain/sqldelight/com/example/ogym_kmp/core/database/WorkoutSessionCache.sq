CREATE TABLE cached_workout_session (
    id TEXT NOT NULL PRIMARY KEY,
    owner_id TEXT,
    name TEXT NOT NULL,
    source_template_id TEXT,
    started_at_epoch_milliseconds INTEGER NOT NULL,
    completed_at_epoch_milliseconds INTEGER,
    created_at_epoch_milliseconds INTEGER NOT NULL,
    sync_status TEXT NOT NULL
);

CREATE TABLE cached_workout_exercise (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    exercise_id TEXT,
    exercise_name TEXT NOT NULL,
    position_in_workout INTEGER NOT NULL
);

CREATE TABLE cached_workout_set (
    id TEXT NOT NULL PRIMARY KEY,
    workout_exercise_id TEXT NOT NULL,
    position_in_exercise INTEGER NOT NULL,
    reps INTEGER NOT NULL,
    weight REAL NOT NULL,
    weight_unit TEXT NOT NULL,
    completed INTEGER NOT NULL
);

selectCachedWorkoutSessions:
SELECT * FROM cached_workout_session ORDER BY started_at_epoch_milliseconds DESC;

selectPendingWorkoutSessions:
SELECT * FROM cached_workout_session WHERE sync_status = 'PENDING_SYNC';

selectCachedWorkoutExercises:
SELECT * FROM cached_workout_exercise WHERE session_id = ? ORDER BY position_in_workout;

selectCachedWorkoutSets:
SELECT * FROM cached_workout_set WHERE workout_exercise_id = ? ORDER BY position_in_exercise;

insertCachedWorkoutSession:
INSERT OR REPLACE INTO cached_workout_session VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertCachedWorkoutExercise:
INSERT OR REPLACE INTO cached_workout_exercise VALUES (?, ?, ?, ?, ?);

insertCachedWorkoutSet:
INSERT OR REPLACE INTO cached_workout_set VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSyncedWorkoutSets:
DELETE FROM cached_workout_set WHERE workout_exercise_id IN (
    SELECT id FROM cached_workout_exercise WHERE session_id IN (
        SELECT id FROM cached_workout_session WHERE sync_status = 'SYNCED'
    )
);

deleteSyncedWorkoutExercises:
DELETE FROM cached_workout_exercise WHERE session_id IN (
    SELECT id FROM cached_workout_session WHERE sync_status = 'SYNCED'
);

deleteSyncedWorkoutSessions:
DELETE FROM cached_workout_session WHERE sync_status = 'SYNCED';

deleteWorkoutSetsForSession:
DELETE FROM cached_workout_set WHERE workout_exercise_id IN (
    SELECT id FROM cached_workout_exercise WHERE session_id = ?
);

deleteWorkoutExercisesForSession:
DELETE FROM cached_workout_exercise WHERE session_id = ?;

deleteWorkoutSession:
DELETE FROM cached_workout_session WHERE id = ?;
